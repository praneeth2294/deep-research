# ---------------------------------------------------------------------------
# deep-research configuration
# Copy to .env and fill in. NEVER commit the real .env file.
# Every variable maps 1:1 to a field in src/deep_research/config.py
# ---------------------------------------------------------------------------

# dev | staging | prod
ENVIRONMENT=dev

# --- LLM providers (Phase 1+) ----------------------------------------------
# Google AI Studio key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# --- Tools (Phase 1+) -------------------------------------------------------
# Tavily web search (https://app.tavily.com) - free tier is enough for dev
TAVILY_API_KEY=

# --- Model tiering (Phase 3 wires these into real clients) ------------------
# cheap: stable alias, always points at a serving flash model
CHEAP_MODEL=gemini-flash-lite-latest
# strong: free-tier keys have no pro-model quota; set gemini-pro-latest on a paid key
STRONG_MODEL=gemini-flash-latest

# --- Budgets & hard limits --------------------------------------------------
MAX_SESSION_BUDGET_USD=1.0
MAX_REACT_ITERATIONS=5
MAX_WRITER_REVISIONS=2
# Shared across ALL LLM calls incl. parallel researchers. Free-tier Gemini
# enforces ~10-20 RPM and small per-day quotas per model - keep this low.
REQUESTS_PER_MINUTE=12
